---
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localeHref } from "@/lib/site";

const title = t("ru", "notfound.title");
const description = t("ru", "notfound.desc");
---

<BaseLayout lang="ru" title={title} description={description} path="404/" noindex>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1>{title}</h1>
    <p class="notfound__desc">{description}</p>
    <div class="notfound__actions">
      <a class="btn btn--cyan" href={localeHref("ru", "")}>{t("ru", "notfound.home")}</a>
      <a class="btn" href={localeHref("ru", "wiki/")}>{t("ru", "notfound.wiki")}</a>
    </div>
  </section>
</BaseLayout>

<style>
.notfound {
  display: grid;
  justify-items: center;
  gap: 14px;
  padding: clamp(48px, 12vh, 120px) 0 clamp(64px, 14vh, 140px);
  text-align: center;
}

.notfound__code {
  font-family: var(--font-display);
  font-size: clamp(76px, 18vw, 148px);
  line-height: 1;
  letter-spacing: 0.02em;
  background: var(--grad-text);
  background-clip: text;
  color: transparent;
}

.notfound__desc {
  max-width: 46ch;
  color: var(--muted);
}

.notfound__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 10px;
}

@media (forced-colors: active) {
  .notfound__code {
    color: CanvasText;
    background: none;
  }
}
</style>
