---
import WikiArticlePage from "@/components/wiki/WikiArticlePage.astro";
import { entrySlug, getEntries, type WikiEntry } from "@/lib/wiki";

export async function getStaticPaths() {
  const entries = await getEntries("ru");
  return entries.map((entry) => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}

interface Props {
  entry: WikiEntry;
}

const { entry } = Astro.props;
---

<WikiArticlePage {entry} />
