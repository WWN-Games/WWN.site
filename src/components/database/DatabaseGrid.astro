---
/* ============================================================================
   WWN — сетка карточек одного таба. Все три сетки рендерятся статически,
   неактивные скрыты атрибутом hidden (остров переключает его по hash).
   ============================================================================ */

import type { TabId } from "@/lib/database";

interface Props {
  tab: TabId;
  hidden?: boolean;
  emptyText: string;
  resetLabel: string;
}

const { tab, hidden = false, emptyText, resetLabel } = Astro.props;
---

<div
  class="database-grid is-shown"
  id={`databaseGrid-${tab}`}
  data-grid={tab}
  role="tabpanel"
  aria-labelledby={`tab-${tab}`}
  hidden={hidden}
>
  <div class="empty-block" data-empty={tab} hidden>
    <span>{emptyText}</span>
    <button class="btn btn--sm" type="button" data-reset-filters hidden>{resetLabel}</button>
  </div>
  <slot />
</div>
