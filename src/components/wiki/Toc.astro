---
import type { MarkdownHeading } from "astro";

import { t } from "@/i18n";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
  headings: MarkdownHeading[];
  /** top — выпадающее «Содержание» под заголовком статьи, side — боковая колонка. */
  placement?: "top" | "side";
}

const { lang, headings, placement = "side" } = Astro.props;
/* В оглавление попадают только h2/h3 — как в legacy wiki.js. */
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const show = placement === "top" ? items.length > 0 : items.length >= 3;
---

{
  show && (
    <details
      class={placement === "top" ? "article__contents" : "article__toc"}
      id={placement === "top" ? "articleContents" : "articleToc"}
    >
      <summary>
        {t(lang, placement === "top" ? "wiki.contents" : "wiki.toc")}
      </summary>
      <ol>
        {items.map((heading) => (
          <li class={heading.depth === 3 ? "lvl-3" : undefined}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}
