---
import { t } from "@/i18n";
import { localeHref, type Lang } from "@/lib/site";

interface Props {
  lang: Lang;
  sectionId: string;
  sectionTitle: string;
  title: string;
}

const { lang, sectionId, sectionTitle, title } = Astro.props;
const hub = localeHref(lang, "wiki/");
---

<div class="article__crumbs" id="crumbs" data-pagefind-ignore>
  <a href={hub}>{t(lang, "nav.wiki")}</a>
  <span class="sep">/</span>
  <a href={`${hub}#wiki-cat-${sectionId}`}>{sectionTitle}</a>
  <span class="sep">/</span>
  <span>{title}</span>
</div>
