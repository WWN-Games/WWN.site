---
import { t } from "@/i18n";
import { type Lang, localeHref } from "@/lib/site";

interface Props {
  lang: Lang;
  sectionId: string;
  sectionTitle: string;
  title: string;
}

const { lang, sectionId, sectionTitle, title } = Astro.props;
const hub = localeHref(lang, "wiki/");
---

<nav
  class="article__crumbs"
  id="crumbs"
  aria-label={t(lang, "a11y.breadcrumb")}
  data-pagefind-ignore
>
  <a href={hub}>{t(lang, "nav.wiki")}</a>
  <span class="sep" aria-hidden="true">/</span>
  <a href={`${hub}#wiki-cat-${sectionId}`}>{sectionTitle}</a>
  <span class="sep" aria-hidden="true">/</span>
  <span aria-current="page">{title}</span>
</nav>
