---
import { Icon } from "astro-icon/components";

import { t } from "@/i18n";
import { LINKS } from "@/lib/config";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const external = { target: "_blank", rel: "noopener" } as const;
---

<section class="section" id="download">
  <div class="wrap">
    <div class="section__head section__head--center" data-reveal>
      <span class="kicker">{t(lang, "nav.download")}</span>
      <h2 class="section__title">{t(lang, "download.title")}</h2>
      <p class="section__sub">{t(lang, "download.subtitle")}</p>
    </div>

    <div class="download-grid">
      <article class="dl-card" data-reveal>
        <div class="dl-card__head">
          <div class="dl-card__icon">
            <Icon name="ph:steam-logo" />
          </div>
          <h3>{t(lang, "download.steam.title")}</h3>
        </div>
        <p>{t(lang, "download.steam.desc")}</p>
        <div class="dl-card__foot">
          <a class="btn btn--cyan" href={LINKS.steam} {...external}
            >{t(lang, "download.steam.btn")}</a
          >
        </div>
      </article>

      <article class="dl-card dl-card--drive" data-reveal>
        <div class="dl-card__head">
          <div class="dl-card__icon">
            <Icon name="ph:google-drive-logo" />
          </div>
          <h3>{t(lang, "download.drive.title")}</h3>
        </div>
        <p>{t(lang, "download.drive.desc")}</p>
        <div class="dl-card__foot">
          <a class="btn btn--red" href={LINKS.drive} {...external}
            >{t(lang, "download.drive.btn")}</a
          >
        </div>
      </article>
    </div>

    <div class="section__head section__head--center download-steps-head" data-reveal>
      <h3 class="section__title">{t(lang, "download.steps.title")}</h3>
    </div>

    <div class="steps">
      <div class="step" data-reveal>
        <h4>{t(lang, "download.step1.title")}</h4>
        <p>{t(lang, "download.step1.desc")}</p>
      </div>
      <div class="step" data-reveal>
        <h4>{t(lang, "download.step2.title")}</h4>
        <p>{t(lang, "download.step2.desc")}</p>
      </div>
      <div class="step" data-reveal>
        <h4>{t(lang, "download.step3.title")}</h4>
        <p>{t(lang, "download.step3.desc")}</p>
      </div>
    </div>
  </div>
</section>
