---
import fer from "@/assets/img/factions/faction-fer.svg";
import proton from "@/assets/img/factions/faction-proton.svg";
import factionsData from "@/data/factions.json";
import { type DictKey, t } from "@/i18n";
import { type Lang, localeHref } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const EMBLEMS: Record<string, ImageMetadata> = { fenearth: fer, proton };
const CHIPS: Record<string, DictKey[]> = {
  fenearth: ["factions.chip.industry", "factions.chip.fleet", "factions.chip.tech"],
  proton: ["factions.chip.mass", "factions.chip.repair", "factions.chip.vasst"],
};

const factions = factionsData.factions
  .filter((faction) => faction.id in EMBLEMS)
  .map((faction) => ({
    id: faction.id,
    color: faction.color,
    emblem: EMBLEMS[faction.id]?.src ?? "",
    name: faction.name[lang],
    motto: faction.motto?.[lang] ?? "",
    desc: faction.desc[lang],
    chips: CHIPS[faction.id] ?? [],
    href: localeHref(lang, `wiki/${faction.lore}/`),
  }));
---

<section class="section section--bordered section--alt" id="factions">
  <div class="wrap">
    <div class="section__head" data-reveal>
      <span class="kicker">{t(lang, "facsec.kicker")}</span>
      <h2 class="section__title">{t(lang, "facsec.title")}</h2>
      <p class="section__sub">{t(lang, "facsec.sub")}</p>
    </div>

    <div class="factions-showcase">
      {
        factions.map((faction) => (
          <article class="fac" style={`--faction-color:${faction.color}`} data-reveal>
            <div class="fac__top">
              <div class="fac__emblem">
                <img src={faction.emblem} alt={faction.name} loading="lazy" />
              </div>
              <div>
                <div class="fac__name">{faction.name}</div>
                <div class="fac__motto">{faction.motto}</div>
              </div>
            </div>
            <p class="fac__desc">{faction.desc}</p>
            <div class="fac__row">
              {faction.chips.map((chip) => (
                <span class="chip">{t(lang, chip)}</span>
              ))}
            </div>
            <a class="btn btn--sm fac__link" href={faction.href}>
              {t(lang, "facsec.openLore")}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
