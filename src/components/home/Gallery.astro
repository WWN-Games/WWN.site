---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import { gallery } from "@/data/gallery";
import { t } from "@/i18n";
import type { Lang } from "@/lib/site";

import GalleryLightbox from "./GalleryLightbox.svelte";

interface Props {
  lang: Lang;
}

interface ResolvedGalleryItem {
  image: ImageMetadata;
  caption: string;
  wide: boolean;
  tall: boolean;
  lightboxSrc: string;
}

const GALLERY_SIZES =
  "(max-width: 580px) 100vw, (max-width: 1120px) 50vw, (max-width: 1400px) 33vw, 25vw";

const { lang } = Astro.props;

/* Картинки галереи берём из src/assets/img/gallery на сборке: данные хранят
   только имя файла, а модули изображений резолвит Vite. */
const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img/gallery/*.avif",
  { eager: true },
);

const resolved = (
  await Promise.all(
    gallery.map(async (item): Promise<ResolvedGalleryItem | null> => {
      const file = item.src;
      const entry = galleryImages[`/src/assets/img/gallery/${file}`];
      if (!entry) return null;
      const lightbox = await getImage({
        src: entry.default,
        width: Math.min(1240, entry.default.width),
        format: "avif",
      });
      return {
        image: entry.default,
        caption: item.caption[lang],
        wide: item.wide === true,
        tall: item.tall === true,
        lightboxSrc: lightbox.src,
      };
    }),
  )
).filter((item): item is ResolvedGalleryItem => item !== null);

const lightboxItems = resolved.map((item) => ({ src: item.lightboxSrc, caption: item.caption }));
const lightboxLabels = {
  dialog: t(lang, "a11y.gallery"),
  close: t(lang, "gallery.close"),
  prev: t(lang, "gallery.prev"),
  next: t(lang, "gallery.next"),
};
---

{resolved.length > 0 && (
  <>
    <section class="section section--bordered section--alt" id="gallery">
      <div class="wrap">
        <div class="section__head" data-reveal>
          <span class="kicker">{t(lang, "gallery.title")}</span>
          <h2 class="section__title">{t(lang, "gallery.subtitle")}</h2>
        </div>

        <div class="gallery" id="galleryGrid" data-reveal>
          {resolved.map((item, index) => (
            <button
              type="button"
              class={`gallery__item${item.wide ? " gallery__item--wide" : ""}${item.tall ? " gallery__item--tall" : ""}`}
              data-gallery-index={index}
              aria-label={item.caption}
            >
              <Image
                src={item.image}
                alt={item.caption}
                widths={[320, 480, 640, 960]}
                sizes={GALLERY_SIZES}
                format="avif"
                loading="lazy"
                decoding="async"
              />
              <span class="gallery__cap">{item.caption}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <GalleryLightbox client:idle items={lightboxItems} labels={lightboxLabels} />
  </>
)}

<style>
  .gallery__item {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
  }
</style>
