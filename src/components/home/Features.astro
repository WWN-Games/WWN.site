---
import { type DictKey, t } from "@/i18n";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
}

interface Feature {
  title: DictKey;
  desc: DictKey;
  icon: string;
}

const { lang } = Astro.props;

const features: Feature[] = [
  {
    title: "features.f1.title",
    desc: "features.f1.desc",
    icon: '<path d="M12 2 4 7v10l8 5 8-5V7z" /><path d="M12 22V12M4 7l8 5 8-5" />',
  },
  {
    title: "features.f2.title",
    desc: "features.f2.desc",
    icon: '<path d="M12 2 3 6v6c0 5 3.8 8.4 9 10 5.2-1.6 9-5 9-10V6z" /><path d="m9 12 2 2 4-4" />',
  },
  {
    title: "features.f3.title",
    desc: "features.f3.desc",
    icon: '<path d="M9 20 3 17V4l6 3 6-3 6 3v13l-6-3-6 3z" /><path d="M9 7v13M15 4v13" />',
  },
  {
    title: "features.f4.title",
    desc: "features.f4.desc",
    icon: '<path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" /><path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" /><path d="M12 12h.01" />',
  },
  {
    title: "features.f5.title",
    desc: "features.f5.desc",
    icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />',
  },
  {
    title: "features.f6.title",
    desc: "features.f6.desc",
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />',
  },
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section__head section__head--center" data-reveal>
      <span class="kicker">{t(lang, "features.title")}</span>
      <h2 class="section__title">{t(lang, "features.subtitle")}</h2>
    </div>

    <div class="cards">
      {
        features.map((feature) => (
          <article class="card" data-reveal>
            <div class="card__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={feature.icon}
              />
            </div>
            <h3 class="card__title">{t(lang, feature.title)}</h3>
            <p class="card__text">{t(lang, feature.desc)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
