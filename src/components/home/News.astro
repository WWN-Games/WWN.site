---
import { getCollection } from "astro:content";

import NewsCard from "@/components/news/NewsCard.astro";
import { t } from "@/i18n";
import { sortNews } from "@/lib/news";
import { type Lang, localeHref } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = (await getCollection("news"))
  .filter((entry) => !entry.data.draft)
  .map((entry) => entry.data)
  .sort(sortNews)
  .slice(0, 3);
---

<section class="section" id="news">
  <div class="wrap">
    <div class="section__head" data-reveal>
      <span class="kicker">{t(lang, "news.title")}</span>
      <h2 class="section__title">{t(lang, "news.subtitle")}</h2>
    </div>
    {
      items.length > 0 ? (
        <div class="news" id="newsGrid" data-reveal>
          {items.map((item) => (
            <NewsCard {item} {lang} />
          ))}
        </div>
      ) : (
        <p class="empty-block">{t(lang, "news.empty")}</p>
      )
    }
    <div class="section__actions">
      <a class="btn btn--ghost" href={localeHref(lang, "news/")}>{t(lang, "news.all")}</a>
    </div>
  </div>
</section>

<style>
  .section__actions {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }
</style>
