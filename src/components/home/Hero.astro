---
import { Image } from "astro:assets";

import banner from "@/assets/img/bg/banner-1440.avif";
import { t } from "@/i18n";
import { LINKS, WWN_VERSION } from "@/lib/config";
import { type Lang, localeHref } from "@/lib/site";
import { formatNumber } from "@/lib/utils";
import { getStats } from "@/lib/wiki";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const stats = await getStats();
const external = { target: "_blank", rel: "noopener" } as const;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <Image
      src={banner}
      alt=""
      class="hero__bg-img"
      layout="full-width"
      widths={[960, 1440]}
      priority
    />
  </div>
  <div class="hero__grade" aria-hidden="true"></div>
  <div class="hero__aura" aria-hidden="true"></div>
  <div class="hero__meteors" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>

  <div class="wrap hero__inner">
    <span class="hero__badge">
      <span class="dot"></span>
      <span>{t(lang, "hero.badge", { version: WWN_VERSION })}</span>
    </span>

    <div class="hero__divider" aria-hidden="true">
      <span></span><i>WWN&nbsp;//&nbsp;RUSTED&nbsp;WARFARE</i><span></span>
    </div>

    <h1 class="hero__title"><Fragment set:html={t(lang, "hero.title")} /></h1>

    <p class="hero__desc">{t(lang, "hero.desc")}</p>

    <div class="hero__cta">
      <a class="btn btn--lg" href={LINKS.steam} {...external}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"
          />
        </svg>
        <span>{t(lang, "hero.downloadSteam")}</span>
      </a>
      <a class="btn btn--lg" href={LINKS.drive} {...external}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.01 1.485c-2.082 0-3.754.02-3.743.047.01.02 1.708 3.001 3.774 6.62l3.76 6.574h3.76c2.081 0 3.753-.02 3.742-.047-.005-.02-1.708-3.001-3.775-6.62l-3.76-6.574zm-4.76 1.73a789.828 789.861 0 0 0-3.63 6.319L0 15.868l1.89 3.298 1.885 3.297 3.62-6.335 3.618-6.33-1.88-3.287C8.1 4.704 7.255 3.22 7.25 3.214zm2.259 12.653-.203.348c-.114.198-.96 1.672-1.88 3.287a423.93 423.948 0 0 1-1.698 2.97c-.01.026 3.24.042 7.222.042h7.244l1.796-3.157c.992-1.734 1.85-3.23 1.906-3.323l.104-.167h-7.249z"
          />
        </svg>
        <span>{t(lang, "hero.downloadDrive")}</span>
      </a>
      <a class="btn btn--lg" href={localeHref(lang, "wiki/")}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
        </svg>
        <span>{t(lang, "hero.openWiki")}</span>
      </a>
    </div>
  </div>

  <div class="hero__stats">
    <span class="stat"
      ><b class="stat__num" data-target={stats.units}>{formatNumber(stats.units, lang)}</b
      ><span class="stat__label">{t(lang, "stats.units")}</span></span
    >
    <span class="stat"
      ><b class="stat__num" data-target={stats.factions}>{formatNumber(stats.factions, lang)}</b
      ><span class="stat__label">{t(lang, "stats.factions")}</span></span
    >
    <span class="stat"
      ><b class="stat__num" data-target={stats.maps}>{formatNumber(stats.maps, lang)}</b
      ><span class="stat__label">{t(lang, "stats.maps")}</span></span
    >
  </div>

  <div class="hero__dock">
    <a href={localeHref(lang, "wiki/")}>{t(lang, "nav.wiki")}</a>
    <span class="sep"></span>
    <a href={localeHref(lang, "database/")}>{t(lang, "database.title")}</a>
    <span class="sep"></span>
    <a href={LINKS.discord} {...external}>Discord</a>
    <span class="sep"></span>
    <a href={LINKS.steam} {...external}>Steam Workshop</a>
  </div>
</section>

<script>
  import "@/scripts/home/hero";
</script>
