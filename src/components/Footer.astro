---
import { Icon } from "astro-icon/components";

import { t } from "@/i18n";
import { LINKS, youtubeFor } from "@/lib/config";
import { href, type Lang, localeHref } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = localeHref(lang, "");
const external = { target: "_blank", rel: "noopener" } as const;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img src={href("img/brand/logo.svg")} alt="WWN" width="862" height="252" />
        <p>{t(lang, "siteTagline")}</p>
        <div class="footer__social">
          <a class="icon-btn" href={LINKS.discord} {...external}>
            <span class="visually-hidden">Discord</span>
            <Icon name="simple-icons:discord" />
          </a>
          <a class="icon-btn" href={LINKS.steam} {...external}>
            <span class="visually-hidden">Steam</span>
            <Icon name="simple-icons:steam" />
          </a>
          <a class="icon-btn" href={youtubeFor(lang)} {...external}>
            <span class="visually-hidden">YouTube</span>
            <Icon name="simple-icons:youtube" />
          </a>
        </div>
      </div>

      <div>
        <h3>{t(lang, "footer.nav")}</h3>
        <ul>
          <li><a href={`${home}#features`}>{t(lang, "nav.features")}</a></li>
          <li><a href={`${home}#factions`}>{t(lang, "nav.factions")}</a></li>
          <li><a href={`${home}#gallery`}>{t(lang, "nav.gallery")}</a></li>
          <li><a href={localeHref(lang, "wiki/")}>{t(lang, "nav.wiki")}</a></li>
          <li><a href={localeHref(lang, "database/")}>{t(lang, "database.title")}</a></li>
        </ul>
      </div>

      <div>
        <h3>{t(lang, "footer.community")}</h3>
        <ul>
          <li><a href={LINKS.discord} {...external}>Discord</a></li>
          <li><a href={LINKS.youtubeEn} {...external}>YouTube EN</a></li>
          <li><a href={LINKS.youtubeRu} {...external}>YouTube RU</a></li>
        </ul>
      </div>

      <div>
        <h3>{t(lang, "footer.download")}</h3>
        <ul>
          <li><a href={LINKS.steam} {...external}>Steam Workshop</a></li>
          <li><a href={LINKS.drive} {...external}>Google Drive</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© <span id="year"></span> WWN. {t(lang, "footer.disclaimer")}</p>
    </div>
  </div>
</footer>
