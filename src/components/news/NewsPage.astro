---
import { getCollection } from "astro:content";

import NewsCard from "@/components/news/NewsCard.astro";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortNews } from "@/lib/news";
import { collectionJsonLd } from "@/lib/seo";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = (await getCollection("news"))
  .filter((entry) => !entry.data.draft)
  .map((entry) => entry.data)
  .toSorted(sortNews);
const description = t(lang, "meta.desc.news");
const jsonLd = collectionJsonLd({
  lang,
  path: "news/",
  title: t(lang, "meta.title.news"),
  description,
  count: items.length,
});
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.title.news")}
  description={description}
  path="news/"
  jsonLd={jsonLd}
>
  <section class="section section--bordered">
    <div class="wrap">
      <div class="section__head">
        <span class="kicker">{t(lang, "news.kicker")}</span>
        <h1 class="section__title">{t(lang, "news.pageTitle")}</h1>
        <p>{t(lang, "news.pageSubtitle")}</p>
      </div>

      {
        items.length > 0 ? (
          <div class="news">
            {items.map((item) => (
              <NewsCard {item} {lang} />
            ))}
          </div>
        ) : (
          <p class="empty-block">{t(lang, "news.empty")}</p>
        )
      }
    </div>
  </section>
</BaseLayout>
