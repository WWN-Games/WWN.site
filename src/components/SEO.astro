---
import { href, type Lang, localeHref, SITE } from "@/lib/site";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Путь без base и языка: "", "wiki/", "wiki/lore/history/", "database/". */
  path: string;
  type?: "website" | "article" | undefined;
  image?: string | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
  noindex?: boolean | undefined;
}

const { lang, title, description, path, type = "website", image, jsonLd, noindex = false } = Astro.props;

const clean = path.replace(/^\/+|\/+$/g, "");
const suffix = clean ? `${clean}/` : "";
const canonicalUrl = `${SITE}${localeHref(lang, suffix)}`;
const ruUrl = `${SITE}${href(suffix)}`;
const enUrl = `${SITE}${href(`en/${suffix}`)}`;
const ogImage = image ?? `${SITE}${href("img/bg/og-banner.webp")}`;
const ogLocale = lang === "ru" ? "ru_RU" : "en_US";
const ogLocaleAlt = lang === "ru" ? "en_US" : "ru_RU";
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="ru" href={ruUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={ruUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="WWN" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlt} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{
  blocks.map((block) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(block).replace(/</g, "\\u003c")}
    />
  ))
}
