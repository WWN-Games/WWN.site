---
import { t } from "@/i18n";
import { NAV_ITEMS } from "@/lib/nav";
import { href, type Lang, localeHref } from "@/lib/site";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
  /** Путь без base и языка; "" — главная. */
  path: string;
}

const { lang, path } = Astro.props;
const home = localeHref(lang, "");
const navItems = NAV_ITEMS.map((item) => ({ ...item, href: localeHref(lang, item.path) }));

const isActive = (section: string) => path.startsWith(section);
---

<header class="header" id="header">
  <div class="header__inner">
    <a class="brand" href={home} aria-label="WWN">
      <img src={href("img/brand/logo.svg")} alt="WWN" width="862" height="252" />
      <span class="brand__sub">{t(lang, "brand.sub")}</span>
    </a>

    <nav class="nav" id="mainNav" aria-label={t(lang, "a11y.nav")}>
      {
        navItems.map((item) => {
          const active = isActive(item.section);
          return (
            <a href={item.href} class={active ? "is-active" : undefined} aria-current={active ? "page" : undefined}>
              {t(lang, item.key)}
            </a>
          );
        })
      }
    </nav>

    <div class="header__side">
      <LangSwitch lang={lang} {path} />
      <button
        class="icon-btn burger"
        id="burger"
        type="button"
        aria-label={t(lang, "a11y.menu")}
        aria-controls="mobileNav"
        aria-expanded="false"
        popovertarget="mobileNav"
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav" popover="auto">
  {
    navItems.map((item) => {
      const active = isActive(item.section);
      return (
        <a href={item.href} aria-current={active ? "page" : undefined}>
          {t(lang, item.key)}
        </a>
      );
    })
  }
  <LangSwitch lang={lang} {path} />
</div>
