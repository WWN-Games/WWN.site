---
import { getCollection } from "astro:content";

import PageIntro from "@/components/ui/PageIntro.astro";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { collectionJsonLd } from "@/lib/seo";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entries = (await getCollection("ratings"))
  .map((entry) => entry.data)
  .toSorted(
    (a, b) =>
      b.rating - a.rating ||
      a.nickname.localeCompare(b.nickname, lang),
  );
const formatter = new Intl.NumberFormat(lang === "en" ? "en-US" : "ru-RU", {
  maximumFractionDigits: 2,
});
const description = t(lang, "meta.desc.rating");
const jsonLd = collectionJsonLd({
  lang,
  path: "rating/",
  title: t(lang, "meta.title.rating"),
  description,
  count: entries.length,
});
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.title.rating")}
  description={description}
  path="rating/"
  jsonLd={jsonLd}
>
  <section class="section section--bordered">
    <div class="wrap">
      <PageIntro
        kicker={t(lang, "rating.kicker")}
        title={t(lang, "rating.title")}
        subtitle={t(lang, "rating.subtitle")}
      />

      {
        entries.length > 0 ? (
          <div class="data-table-wrap rating-table-wrap">
            <table class="data-table rating-table">
              <thead>
                <tr>
                  <th scope="col">{t(lang, "rating.rank")}</th>
                  <th scope="col">{t(lang, "rating.player")}</th>
                  <th scope="col">{t(lang, "rating.score")}</th>
                </tr>
              </thead>
              <tbody>
                {entries.map((entry, index) => (
                  <tr id={entry.id} class:rating-table__top={index < 3}>
                    <td class="data-table__num">{index + 1}</td>
                    <td>{entry.nickname}</td>
                    <td class="data-table__score">{formatter.format(entry.rating)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-block">{t(lang, "rating.empty")}</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .rating-table tr {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .rating-table td:nth-child(2) {
    width: 100%;
  }
  .rating-table__top td {
    color: var(--gold);
  }
</style>
