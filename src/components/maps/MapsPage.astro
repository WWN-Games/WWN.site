---
import { getCollection } from "astro:content";
import { existsSync } from "node:fs";
import path from "node:path";

import PageIntro from "@/components/ui/PageIntro.astro";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { isBadgeNew } from "@/lib/cards";
import { collectionJsonLd } from "@/lib/seo";
import { href, type Lang } from "@/lib/site";
import { formatNumber } from "@/lib/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const publicRoot = path.join(process.cwd(), "public");
const entries = (await getCollection("maps")).toSorted(
  (a, b) => a.data.order - b.data.order || a.data.name[lang].localeCompare(b.data.name[lang], lang),
);
const description = t(lang, "meta.desc.maps");
const jsonLd = collectionJsonLd({
  lang,
  path: "maps/",
  title: t(lang, "meta.title.maps"),
  description,
  count: entries.length,
});
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.title.maps")}
  description={description}
  path="maps/"
  jsonLd={jsonLd}
>
  <section class="section section--bordered">
    <div class="wrap">
      <PageIntro
        kicker={t(lang, "maps.kicker")}
        title={t(lang, "maps.title")}
        subtitle={t(lang, "maps.subtitle")}
      />

      {
        entries.length > 0 ? (
          <div class="catalog-grid">
            {entries.map((entry) => {
              const data = entry.data;
              const showNew = isBadgeNew(data.new, data.newUntil);
              const defaultImage = `img/maps/${entry.id}.avif`;
              const image =
                data.image || existsSync(path.join(publicRoot, defaultImage))
                  ? href(data.image ?? defaultImage)
                  : null;
              return (
                <article class="catalog-card map-card" style="--faction-color:#29b8ff">
                  {showNew && (
                    <span class="badge-new" data-new-until={data.newUntil}>
                      {t(lang, "database.new")}
                    </span>
                  )}
                  {image ? (
                    <a class="catalog-card__media map-card__img" href={image} target="_blank" rel="noopener">
                      <img src={image} alt={data.name[lang]} width="640" height="360" loading="lazy" />
                    </a>
                  ) : (
                    <div class="catalog-card__media map-card__img map-card__img--empty">{data.name[lang].slice(0, 2)}</div>
                  )}
                  <h2 class="catalog-card__title">{data.name[lang]}</h2>
                  <div class="catalog-card__meta map-card__chips">
                    {data.players !== undefined && (
                      <span class="chip">
                        {t(lang, "maps.players")}: {formatNumber(data.players, lang)}
                      </span>
                    )}
                    {data.mode && <span class="chip">{data.mode[lang]}</span>}
                    {data.size && (
                      <span class="chip">
                        {t(lang, "maps.size")}: {data.size[lang]}
                      </span>
                    )}
                    {data.author && (
                      <span class="chip">
                        {t(lang, "maps.author")}: {data.author[lang]}
                      </span>
                    )}
                  </div>
                  <p class="catalog-card__desc">{data.desc[lang]}</p>
                  {data.download && (
                    <div class="catalog-card__footer">
                      <a class="btn btn--sm" href={data.download} target="_blank" rel="noopener">
                        {t(lang, "maps.download")}
                      </a>
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        ) : (
          <p class="empty-block">{t(lang, "maps.empty")}</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .map-card {
    border-top: 2px solid var(--cyan);
  }
  .map-card :global(.badge-new) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
  }
  .map-card__img--empty {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 34px;
    color: var(--cyan);
  }
</style>
