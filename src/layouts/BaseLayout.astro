---
import { Font, fontData } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SEO from "@/components/SEO.astro";
import { t } from "@/i18n";
import { DEFAULT_LOCALE, href, type Lang } from "@/lib/site";
import "@/styles/style.css";

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  /** Путь без base и языка: "", "wiki/", "wiki/lore/history/", "database/". */
  path: string;
  type?: "website" | "article";
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  lang = DEFAULT_LOCALE,
  title,
  description,
  path,
  type = "website",
  image,
  jsonLd,
  noindex = false,
} = Astro.props;

/* Локальные варианты в astro.config.ts объявлены в порядке [latin, cyrillic],
   поэтому preload — ровно два файла активного сабсета: display и body. */
const subsetIndex = lang === "ru" ? 1 : 0;
const fontPreloads = (
  await Promise.all(
    (["--font-display", "--font-body"] as const).map(async (cssVariable) => {
      const variants = fontData[cssVariable] ?? [];
      const variant = variants[subsetIndex] ?? variants[0];
      const src = variant?.src[0];
      if (!src) return null;
      // В статической сборке src.url — уже готовый публичный URL с base.
      return { url: src.url, type: `font/${src.format ?? "woff2"}` };
    }),
  )
).filter((preload): preload is { url: string; type: string } => preload !== null);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050b16" />

    <SEO lang={lang} title={title} description={description} path={path} type={type} image={image} jsonLd={jsonLd} noindex={noindex} />

    <link rel="icon" type="image/svg+xml" href={href("img/brand/favicon.svg")} />
    <link rel="apple-touch-icon" href={href("img/brand/icon-192.png")} />
    <link rel="manifest" href={href("site.webmanifest")} />

    {
      fontPreloads.map((preload) => (
        <link rel="preload" href={preload.url} as="font" type={preload.type} crossorigin="anonymous" />
      ))
    }
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#top">{t(lang, "a11y.skip")}</a>
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    <Header lang={lang} path={path} />

    <main id="top">
      <slot />
    </main>

    <Footer lang={lang} />

    <a class="to-top" id="toTop" href="#top">
      <span class="visually-hidden">{t(lang, "footer.backToTop")}</span>
      <Icon name="ph:caret-up" />
    </a>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
