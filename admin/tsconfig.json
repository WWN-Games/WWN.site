{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "src/lib/**/*.ts", "src/**/*.d.ts"]
}
